{
  "supabase-migration-guard": {
    "PreToolUse": [
      {
        "matcher": "call_mcp_tool|.*apply_migration.*",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/guard-supabase-migration.mjs --agent antigravity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
