# Smarter Dog Grooming Salon - Environment Variables
# Copy this file to .env and fill in your values

# =================================
# EmailJS Configuration (Booking Form)
# =================================
# Get these from: https://dashboard.emailjs.com/
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# =================================
# Google Analytics (GA4)
# =================================
# Get this from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=

# =================================
# Supabase (Customer Login)
# =================================
# From: https://supabase.com/dashboard/project/_/settings/api
# Use the publishable key (sb_publishable_...), not the legacy anon JWT.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
