# ============================================================
# .env.example — Smarter Dog Grooming
#
# Copy to .env.local and fill in the values for local dev.
# Anything prefixed VITE_ is exposed to the browser at build time;
# never put a private secret behind a VITE_ prefix.
#
# Edge Function secrets (ANTHROPIC_API_KEY, META_ACCESS_TOKEN, etc.)
# are NOT read from this file. Set them with `supabase secrets set`
# so they're only available inside the Deno runtime.
# ============================================================

# ── Browser-visible (Vite) ─────────────────────────────────
# Public URL of your Supabase project (the API endpoint).
# All VITE_ vars are bundled into the browser at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key. Safe to expose; RLS does the gatekeeping.
# Get from: Supabase → Project Settings → API → Project API keys.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy anon key fallback. Existing deployments can keep using this while
# newer projects should prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=

# Customer portal SMS login uses Supabase Auth with Twilio Verify configured
# in the Supabase dashboard. Do NOT add Twilio Account SID, Auth Token, or
# Verify Service SID as VITE_ variables; they must never reach the browser.

# Cloudflare Turnstile site key — shown in the login widget. Public; safe here.
# Create a site at dash.cloudflare.com → Turnstile → Add site.
# The matching *secret* key goes into Supabase Auth settings (never this file).
#
# Leave it unset in DEV and the app falls back to Cloudflare's always-passes
# test key, with a warning. Leave it unset in a PRODUCTION build and sign-in is
# BLOCKED on both login pages — a captcha that always passes is worse than
# none, so the app refuses rather than pretending. Setting the test key
# explicitly in production is blocked for the same reason.
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Staff Web Push — the VAPID *public* key (base64url). This is the ONLY
# VAPID key allowed in the browser; it is safe to expose. The matching
# private key is an edge secret only (see VAPID_PRIVATE_KEY below) — never
# put it behind a VITE_ prefix. Generate the pair with:
#   node scripts/generate-vapid-keys.mjs
# Without this var the staff "Enable notifications" UI shows a "not
# configured" message and never subscribes.
# VITE_VAPID_PUBLIC_KEY=

# Sentry browser SDK DSN. Optional in dev — leave unset to disable
# Sentry locally. In production, set on Vercel so the ErrorBoundary
# and unhandled exceptions are reported.
# Get from: sentry.io → Settings → Projects → <project> → Client Keys.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Optional environment tag for Sentry. Defaults to import.meta.env.MODE
# ('production' on a Vercel prod build, 'development' locally).
# VITE_SENTRY_ENVIRONMENT=production

# Owner-only Booking Desk pilot. Development builds show the read-only
# workspace automatically; production stays hidden unless this is exactly 1.
# VITE_BOOKING_WORKSPACE_ENABLED=1


# ── Server/admin-only — NEVER prefix these with VITE_ ───────
# These vars are only for local admin scripts (e.g. seed-first-owner.mjs).
# They must NEVER appear in Vercel frontend env vars or any VITE_ variable.
#
# SUPABASE_URL is used by scripts that run server-side (no VITE_ prefix).
# Leave blank in .env.local unless you are actively running an admin script.
# SUPABASE_URL=https://your-project-ref.supabase.co
#
# Service-role key. Bypasses RLS — treat like a root password.
# Get from: Supabase → Project Settings → API → Project API keys → service_role.
# REMOVE this from .env.local immediately after running the one-off script.
# NEVER commit this. NEVER put it in a VITE_ variable. NEVER paste it in logs.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ============================================================
# Edge Function secrets — set with `supabase secrets set NAME=value`,
# NOT in this file. Listed here so you know what to provision.
# ============================================================
#
# Required for the WhatsApp AI receptionist:
#
# ANTHROPIC_API_KEY      — Claude API key. Server-side only.
# CLAUDE_MODEL           — defaults to claude-sonnet-4-6.
# AGENT_CALLBACK_SECRET  — shared secret between the pg_net trigger
#                          (migration 027) and the whatsapp-agent
#                          Edge Function. Random, ≥32 chars.
#
# Required for outbound messaging:
#
# META_ACCESS_TOKEN      — WhatsApp Cloud API permanent token.
# META_PHONE_NUMBER_ID   — your sending number's ID.
# SEND_INTERNAL_SECRET   — used by whatsapp-agent for auto-send and
#                          by any service-role caller of whatsapp-send.
# WHATSAPP_SEND_ALLOWED_ORIGINS
#                        — optional comma-separated CORS allowlist for the
#                          whatsapp-send function. Defaults to the staging
#                          domain + localhost. Set this to the production
#                          domain(s) before launch, e.g.
#                          "https://smarterdog.co.uk,https://smarterdog.vercel.app".
#
# Receptionist policy flags (added by migration 038):
#
# AI_ASSISTANT_ENABLED   — kill switch. 'true' (default) | 'false'.
#                          When 'false', the agent skips Claude and
#                          writes a brand-voiced fallback draft tagged
#                          for human handoff so staff still see a row.
# AI_AUTO_SEND_LOW_RISK  — global gate for auto-send. 'false' (default)
#                          | 'true'. Even when 'true', a draft only
#                          auto-sends when the conversation has
#                          auto_send_enabled=true AND the draft is low
#                          risk + handoff-free + in the auto-send intent
#                          allowlist.
# WHATSAPP_SEND_URL      — optional. Defaults to
#                          ${SUPABASE_URL}/functions/v1/whatsapp-send.
#
# AI_AUTONOMOUS_BOOKING_ENABLED — 'false' (default) | 'true'. When
#                          'true', AI-staged booking actions in
#                          whatsapp_booking_actions can auto-apply
#                          on customer confirm. Keep off until the
#                          guardrails (capacity recheck, audit log,
#                          rate limit) are validated in staging.
# AI_BOOKING_DAILY_CAP   — integer, default 5. Per-conversation cap
#                          on AI-staged bookings in any rolling 24h
#                          window. Rejected proposals don't count.
#                          Counted from whatsapp_ai_action_audit
#                          (rows with outcome='staged'). When the
#                          cap is hit, further proposals are
#                          rejected with outcome='rejected_rate_limit'.
#
# Required for WhatsApp Flows (whatsapp-flow-endpoint):
#
# FLOW_PRIVATE_KEY       — RSA private key PEM for the Flow Data Endpoint
#                          encryption. Generate with `npm run flow:generate-keys`.
#                          Set via: supabase secrets set FLOW_PRIVATE_KEY="$(cat flow-keys/private.pem)"
#                          Literal "\n" sequences are normalised at runtime.
# FLOW_PASSPHRASE        — passphrase that decrypts FLOW_PRIVATE_KEY.
# META_APP_SECRET        — REUSED from the webhook; verifies the Flow
#                          request's X-Hub-Signature-256 too.
# META_WABA_ID           — REUSED; needed by `npm run flow:publish` to
#                          create/publish Flows.
#
# Used only by the publish script (export in your shell, not a secret):
#
# FLOW_ENDPOINT_URI      — public URL of the deployed whatsapp-flow-endpoint,
#                          e.g. https://<ref>.supabase.co/functions/v1/whatsapp-flow-endpoint
#                          Set on the Flow so Meta knows where to POST.
#
# Required for the customer onboarding address picker (postcode-lookup):
#
# APITIER_API_KEY        — APITier UK PostCode API key. Server-side only —
#                          their docs forbid putting it in frontend code.
#                          Set via: supabase secrets set APITIER_API_KEY=...
#                          Get from: apitier.com → dashboard (UK PostCode API,
#                          PAYG credit required — the free wallet excludes it).
# POSTCODE_LOOKUP_ALLOWED_ORIGINS
#                        — optional comma-separated CORS allowlist for the
#                          postcode-lookup function. Defaults to the staging
#                          domain + localhost (see _shared/cors.ts). Set to the
#                          production domain(s) before launch, e.g.
#                          "https://smarterdog.co.uk,https://smarterdog.vercel.app".
#
# Staff Web Push (notify-staff edge function) — set via `supabase secrets set`,
# NEVER as VITE_ and NEVER committed. Generate the VAPID pair with
# `node scripts/generate-vapid-keys.mjs`:
#
# STAFF_PUSH_ENABLED     — master kill switch. Defaults OFF; notify-staff is a
#                          no-op until set to "true". Dark-launch gate.
#                          Set via: supabase secrets set STAFF_PUSH_ENABLED=true
# VAPID_PUBLIC_KEY       — VAPID public key (base64url). Same value as
#                          VITE_VAPID_PUBLIC_KEY; the edge function sends it in
#                          the `k=` Authorization param.
# VAPID_PRIVATE_KEY      — VAPID private key (base64url, 32-byte scalar).
#                          SECRET — edge only. Signs the VAPID JWT.
# VAPID_SUBJECT          — contact URI in the VAPID JWT, e.g.
#                          "mailto:leam@leamonline.uk". Defaults to that if unset.
# (notify-staff also reuses the existing WEBHOOK_SECRET / SEND_INTERNAL_SECRET
#  for inbound auth, and SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY which Supabase
#  injects automatically — no new values needed for those.)

# ── Day-closure broadcast (broadcast-message edge fn, Feature 2) ─────────────
# Staff-initiated 1:1 templated messages to every Booked customer for a chosen
# day. Independent of the AI auto-send gates.
#
# BROADCAST_MESSAGE_ENABLED — kill switch. Defaults OFF ("false"); the function
#                             refuses to send until set to "true". Even then it
#                             only sends once the `day_closure_v1` whatsapp_templates
#                             row is status='approved' (submit it to Meta first).
#                             Set via: supabase secrets set BROADCAST_MESSAGE_ENABLED=true
# BROADCAST_MESSAGE_ALLOWED_ORIGINS — comma-separated CORS allowlist for the
#                             staff-dashboard call (same pattern as the other
#                             *_ALLOWED_ORIGINS).
# (Reuses SEND_INTERNAL_SECRET for the internal whatsapp-send / sms-send calls,
#  and SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY / SUPABASE_ANON_KEY — no new
#  secrets beyond the two above.)

# ── #salon-today Slack alerts (slack-alerts edge fn) ─────────────────────────
# Operational alerts into the salon's Slack channel: anything that changes
# today, or needs a human to act today. Set via `supabase secrets set`, NEVER
# as VITE_ and NEVER committed. Full reference: docs/slack-alerts.md
#
# SLACK_ALERTS_ENABLED      — master kill switch. Defaults OFF ("false"); the
#                             function returns {skipped:true} until set to
#                             "true", so the trigger and cron jobs can be live
#                             before the channel is. Turning it back off is one
#                             command — no deploy, no migration, no revert.
#                             Set via: supabase secrets set SLACK_ALERTS_ENABLED=true
# SLACK_ALERTS_DRY_RUN      — when "true", everything is computed and the
#                             deduplication claim is recorded, but nothing is
#                             posted; the message is logged instead. Use it to
#                             watch a real day — in particular to confirm the
#                             5-minute sweep alerts fire ONCE rather than twelve
#                             times — before going live.
# SLACK_SALON_TODAY_WEBHOOK — the Slack incoming-webhook URL for #salon-today.
#                             SECRET: anyone holding it can post to the channel.
#                             Create at api.slack.com → Your Apps → Incoming
#                             Webhooks. Read in exactly one place in the code.
# (Also reuses WEBHOOK_SECRET for inbound auth, plus SUPABASE_URL /
#  SUPABASE_SERVICE_ROLE_KEY which Supabase injects automatically.)
#
# Sentry → Slack is configured in the Sentry UI, not here. Point it at a
# different channel: a stack trace is not "something a human must do today".
