# ============================================================
# .env.example — Smarter Dog Grooming
#
# Copy to .env.local and fill in the values for local dev.
# Anything prefixed VITE_ is exposed to the browser at build time;
# never put a private secret behind a VITE_ prefix.
#
# Edge Function secrets (ANTHROPIC_API_KEY, META_ACCESS_TOKEN, etc.)
# are NOT read from this file. Set them with `supabase secrets set`
# so they're only available inside the Deno runtime.
# ============================================================

# ── Browser-visible (Vite) ─────────────────────────────────
# Public URL of your Supabase project (the API endpoint).
# All VITE_ vars are bundled into the browser at build time.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Publishable key. Safe to expose; RLS does the gatekeeping.
# Get from: Supabase → Project Settings → API → Project API keys.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Legacy anon key fallback. Existing deployments can keep using this while
# newer projects should prefer VITE_SUPABASE_PUBLISHABLE_KEY.
# VITE_SUPABASE_ANON_KEY=

# Customer portal SMS login uses Supabase Auth with Twilio Verify configured
# in the Supabase dashboard. Do NOT add Twilio Account SID, Auth Token, or
# Verify Service SID as VITE_ variables; they must never reach the browser.

# Cloudflare Turnstile site key — shown in the login widget.
# Create a site at dash.cloudflare.com → Turnstile → Add site.
# The matching *secret* key goes into Supabase Auth settings (not here).
# Fallback in code: Cloudflare's always-passes test key (dev only).
VITE_TURNSTILE_SITE_KEY=your-turnstile-site-key-here

# Sentry browser SDK DSN. Optional in dev — leave unset to disable
# Sentry locally. In production, set on Vercel so the ErrorBoundary
# and unhandled exceptions are reported.
# Get from: sentry.io → Settings → Projects → <project> → Client Keys.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# Optional environment tag for Sentry. Defaults to import.meta.env.MODE
# ('production' on a Vercel prod build, 'development' locally).
# VITE_SENTRY_ENVIRONMENT=production


# ── Server/admin-only — NEVER prefix these with VITE_ ───────
# These vars are only for local admin scripts (e.g. seed-first-owner.mjs).
# They must NEVER appear in Vercel frontend env vars or any VITE_ variable.
#
# SUPABASE_URL is used by scripts that run server-side (no VITE_ prefix).
# Leave blank in .env.local unless you are actively running an admin script.
# SUPABASE_URL=https://your-project-ref.supabase.co
#
# Service-role key. Bypasses RLS — treat like a root password.
# Get from: Supabase → Project Settings → API → Project API keys → service_role.
# REMOVE this from .env.local immediately after running the one-off script.
# NEVER commit this. NEVER put it in a VITE_ variable. NEVER paste it in logs.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ============================================================
# Edge Function secrets — set with `supabase secrets set NAME=value`,
# NOT in this file. Listed here so you know what to provision.
# ============================================================
#
# Required for the WhatsApp AI receptionist:
#
# ANTHROPIC_API_KEY      — Claude API key. Server-side only.
# CLAUDE_MODEL           — defaults to claude-sonnet-4-6.
# AGENT_CALLBACK_SECRET  — shared secret between the pg_net trigger
#                          (migration 027) and the whatsapp-agent
#                          Edge Function. Random, ≥32 chars.
#
# Required for outbound messaging:
#
# META_ACCESS_TOKEN      — WhatsApp Cloud API permanent token.
# META_PHONE_NUMBER_ID   — your sending number's ID.
# SEND_INTERNAL_SECRET   — used by whatsapp-agent for auto-send and
#                          by any service-role caller of whatsapp-send.
# WHATSAPP_SEND_ALLOWED_ORIGINS
#                        — optional comma-separated CORS allowlist for the
#                          whatsapp-send function. Defaults to the staging
#                          domain + localhost. Set this to the production
#                          domain(s) before launch, e.g.
#                          "https://book.smarterdog.co.uk,https://smarterdog.vercel.app".
#
# Receptionist policy flags (added by migration 038):
#
# AI_ASSISTANT_ENABLED   — kill switch. 'true' (default) | 'false'.
#                          When 'false', the agent skips Claude and
#                          writes a brand-voiced fallback draft tagged
#                          for human handoff so staff still see a row.
# AI_AUTO_SEND_LOW_RISK  — global gate for auto-send. 'false' (default)
#                          | 'true'. Even when 'true', a draft only
#                          auto-sends when the conversation has
#                          auto_send_enabled=true AND the draft is low
#                          risk + handoff-free + in the auto-send intent
#                          allowlist.
# WHATSAPP_SEND_URL      — optional. Defaults to
#                          ${SUPABASE_URL}/functions/v1/whatsapp-send.
#
# AI_AUTONOMOUS_BOOKING_ENABLED — 'false' (default) | 'true'. When
#                          'true', AI-staged booking actions in
#                          whatsapp_booking_actions can auto-apply
#                          on customer confirm. Keep off until the
#                          guardrails (capacity recheck, audit log,
#                          rate limit) are validated in staging.
# AI_BOOKING_DAILY_CAP   — integer, default 5. Per-conversation cap
#                          on AI-staged bookings in any rolling 24h
#                          window. Rejected proposals don't count.
#                          Counted from whatsapp_ai_action_audit
#                          (rows with outcome='staged'). When the
#                          cap is hit, further proposals are
#                          rejected with outcome='rejected_rate_limit'.
