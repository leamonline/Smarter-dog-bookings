// Copy this file to Config.local.xcconfig in this same folder, then replace the
// two values. Config.local.xcconfig is gitignored. Do not commit it.
//
// Supabase → your project → Project Settings → API.
// Copy the project URL and the publishable key (the public key).
// Do not copy the service_role key.
//
// Leave the :/$()/ spelling. A normal https:// is treated as a comment in this
// file. Xcode turns :/$()/ back into ://.

SUPABASE_URL = https:/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY = YOUR_PUBLISHABLE_KEY
