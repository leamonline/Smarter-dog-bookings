{
  "name": "smarter-dogs-smart-humans",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "seed": "tsx src/supabase/seed.ts",
    "test": "vitest run",
    "test:logic": "vitest run --project=logic",
    "test:component": "vitest run --project=component",
    "test:db": "supabase test db",
    "test:db:capacity-concurrency": "PGHOST=${PGHOST:-127.0.0.1} PGPORT=${PGPORT:-54322} PGDATABASE=${PGDATABASE:-postgres} PGUSER=${PGUSER:-postgres} PGPASSWORD=${PGPASSWORD:-postgres} bash scripts/verify-capacity-concurrency.sh",
    "test:db:concurrency": "PGHOST=${PGHOST:-127.0.0.1} PGPORT=${PGPORT:-54322} PGDATABASE=${PGDATABASE:-postgres} PGUSER=${PGUSER:-postgres} PGPASSWORD=${PGPASSWORD:-postgres} bash scripts/verify-db-concurrency.sh",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:bootprobe": "playwright test -c playwright.bootprobe.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node-tests.json",
    "lint": "eslint . && node scripts/check-import-extensions.mjs && node scripts/check-duplicate-files.mjs && node scripts/check-lockfile-platform.mjs && node scripts/check-hosted-supabase-targets.mjs",
    "check:docs": "node scripts/check-doc-links.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:edge-types": "node scripts/check-edge-function-types.mjs",
    "check:edge-auth": "node scripts/check-edge-function-auth.mjs",
    "flow:generate-keys": "node scripts/generate-flow-keys.mjs",
    "vapid:generate": "node scripts/generate-vapid-keys.mjs",
    "flow:publish": "node scripts/publish-flow.mjs",
    "flow:send": "node scripts/send-flow.mjs"
  },
  "repository": {
    "type": "git",
    "url": "http://local_proxy@127.0.0.1:33323/git/leamonline/Smarter-dogs-smart-humans"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-aria": "^3.51.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "supabase": "^2.115.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
