-- Schema-only database dumps deliberately contain no Vault data. Tests that
-- exercise live booking INSERT triggers therefore need inert local secrets.
-- Each including test runs inside a transaction, so newly created fixtures
-- roll back with that test; hosted databases with real secrets are untouched.
do $pgtap_vault$
begin
  if not exists (
    select 1 from vault.secrets where name = 'supabase_url'
  ) then
    perform vault.create_secret(
      'http://localhost:54321',
      'supabase_url',
      'pgtap-local-booking-policy-fixture'
    );
  end if;

  if not exists (
    select 1 from vault.secrets where name = 'webhook_secret'
  ) then
    perform vault.create_secret(
      'pgtap-local-secret',
      'webhook_secret',
      'pgtap-local-booking-policy-fixture'
    );
  end if;
end;
$pgtap_vault$;
