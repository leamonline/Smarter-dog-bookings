{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-combined.mjs",
  "outputDirectory": "dist-combined",
  "redirects": [
    {
      "source": "/customer/book",
      "destination": "/book/new",
      "permanent": true
    },
    {
      "source": "/customer",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/customer/:path*",
      "destination": "/book/:path*",
      "permanent": true
    },
    {
      "source": "/stafflogin",
      "destination": "/staff",
      "permanent": false
    },
    {
      "source": "/today",
      "destination": "/staff/today",
      "permanent": true
    },
    {
      "source": "/today/:path*",
      "destination": "/staff/today/:path*",
      "permanent": true
    },
    {
      "source": "/dogs",
      "destination": "/staff/dogs",
      "permanent": true
    },
    {
      "source": "/dogs/:path*",
      "destination": "/staff/dogs/:path*",
      "permanent": true
    },
    {
      "source": "/humans",
      "destination": "/staff/humans",
      "permanent": true
    },
    {
      "source": "/humans/:path*",
      "destination": "/staff/humans/:path*",
      "permanent": true
    },
    {
      "source": "/inbox",
      "destination": "/staff/inbox",
      "permanent": true
    },
    {
      "source": "/inbox/:path*",
      "destination": "/staff/inbox/:path*",
      "permanent": true
    },
    {
      "source": "/reports",
      "destination": "/staff/reports",
      "permanent": true
    },
    {
      "source": "/reports/:path*",
      "destination": "/staff/reports/:path*",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/staff/settings",
      "permanent": true
    },
    {
      "source": "/settings/:path*",
      "destination": "/staff/settings/:path*",
      "permanent": true
    },
    {
      "source": "/whatsapp",
      "destination": "/staff/whatsapp",
      "permanent": true
    },
    {
      "source": "/whatsapp/:path*",
      "destination": "/staff/whatsapp/:path*",
      "permanent": true
    },
    {
      "source": "/needs-attention",
      "destination": "/staff/needs-attention",
      "permanent": true
    },
    {
      "source": "/needs-attention/:path*",
      "destination": "/staff/needs-attention/:path*",
      "permanent": true
    },
    {
      "source": "/booking-workspace",
      "destination": "/staff/booking-workspace",
      "permanent": true
    },
    {
      "source": "/booking-workspace/:path*",
      "destination": "/staff/booking-workspace/:path*",
      "permanent": true
    },
    {
      "source": "/dev",
      "destination": "/staff/dev",
      "permanent": true
    },
    {
      "source": "/dev/:path*",
      "destination": "/staff/dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/book",
      "destination": "/app/index.html"
    },
    {
      "source": "/book/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/staff",
      "destination": "/app/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/(book|staff|stafflogin|reset-password|app)(/.*)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://api.pwnedpasswords.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(app/assets|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(fonts|icons|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|registerSW\\.js|push-sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(workbox-.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "smarterdog.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
