{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-combined.mjs",
  "outputDirectory": "dist-combined",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.smarterdog.co.uk" }],
      "destination": "https://smarterdog.co.uk/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.smarterdog.co.uk" }],
      "destination": "https://smarterdog.co.uk/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/about",
      "destination": "/approach",
      "permanent": true
    },
    {
      "source": "/about/",
      "destination": "/approach",
      "permanent": true
    },
    {
      "source": "/contact-us",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contact-us/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/f-a-qs",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/f-a-qs/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/raw-food",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/raw-food/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/services/",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/approach/",
      "destination": "/approach",
      "permanent": true
    },
    {
      "source": "/faq/",
      "destination": "/faq",
      "permanent": true
    },
    {
      "source": "/houndsly/",
      "destination": "/houndsly",
      "permanent": true
    },
    {
      "source": "/privacy/",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/terms/",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/matted-coat-policy/",
      "destination": "/matted-coat-policy",
      "permanent": true
    },
    {
      "source": "/community/",
      "destination": "/community",
      "permanent": true
    },
    {
      "source": "/nervous-anxious-dog-grooming/",
      "destination": "/nervous-anxious-dog-grooming",
      "permanent": true
    },
    {
      "source": "/senior-blind-deaf-dog-grooming/",
      "destination": "/senior-blind-deaf-dog-grooming",
      "permanent": true
    },
    {
      "source": "/doodle-grooming-matted-coats/",
      "destination": "/doodle-grooming-matted-coats",
      "permanent": true
    },
    {
      "source": "/dog-de-shedding-ashton-under-lyne/",
      "destination": "/dog-de-shedding-ashton-under-lyne",
      "permanent": true
    },
    {
      "source": "/sensitive-skin-dog-grooming-natural-shampoo/",
      "destination": "/sensitive-skin-dog-grooming-natural-shampoo",
      "permanent": true
    },
    {
      "source": "/independent-dog-groomer-vs-chain/",
      "destination": "/independent-dog-groomer-vs-chain",
      "permanent": true
    },
    {
      "source": "/customer/book",
      "destination": "/book/new",
      "permanent": true
    },
    {
      "source": "/customer",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/customer/:path*",
      "destination": "/book/:path*",
      "permanent": true
    },
    {
      "source": "/stafflogin",
      "destination": "/staff",
      "permanent": false
    },
    {
      "source": "/today",
      "destination": "/staff/today",
      "permanent": true
    },
    {
      "source": "/today/:path*",
      "destination": "/staff/today/:path*",
      "permanent": true
    },
    {
      "source": "/dogs",
      "destination": "/staff/dogs",
      "permanent": true
    },
    {
      "source": "/dogs/:path*",
      "destination": "/staff/dogs/:path*",
      "permanent": true
    },
    {
      "source": "/humans",
      "destination": "/staff/humans",
      "permanent": true
    },
    {
      "source": "/humans/:path*",
      "destination": "/staff/humans/:path*",
      "permanent": true
    },
    {
      "source": "/inbox",
      "destination": "/staff/inbox",
      "permanent": true
    },
    {
      "source": "/inbox/:path*",
      "destination": "/staff/inbox/:path*",
      "permanent": true
    },
    {
      "source": "/reports",
      "destination": "/staff/reports",
      "permanent": true
    },
    {
      "source": "/reports/:path*",
      "destination": "/staff/reports/:path*",
      "permanent": true
    },
    {
      "source": "/settings",
      "destination": "/staff/settings",
      "permanent": true
    },
    {
      "source": "/settings/:path*",
      "destination": "/staff/settings/:path*",
      "permanent": true
    },
    {
      "source": "/whatsapp",
      "destination": "/staff/whatsapp",
      "permanent": true
    },
    {
      "source": "/whatsapp/:path*",
      "destination": "/staff/whatsapp/:path*",
      "permanent": true
    },
    {
      "source": "/needs-attention",
      "destination": "/staff/needs-attention",
      "permanent": true
    },
    {
      "source": "/needs-attention/:path*",
      "destination": "/staff/needs-attention/:path*",
      "permanent": true
    },
    {
      "source": "/booking-workspace",
      "destination": "/staff/booking-workspace",
      "permanent": true
    },
    {
      "source": "/booking-workspace/:path*",
      "destination": "/staff/booking-workspace/:path*",
      "permanent": true
    },
    {
      "source": "/dev",
      "destination": "/staff/dev",
      "permanent": true
    },
    {
      "source": "/dev/:path*",
      "destination": "/staff/dev/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/book",
      "destination": "/app/index.html"
    },
    {
      "source": "/book/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/staff",
      "destination": "/app/index.html"
    },
    {
      "source": "/staff/",
      "destination": "/app/index.html"
    },
    {
      "source": "/staff/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/app/index.html"
    },
    {
      "source": "/reset-password/",
      "destination": "/app/index.html"
    },
    {
      "source": "/services",
      "destination": "/services/index.html"
    },
    {
      "source": "/approach",
      "destination": "/approach/index.html"
    },
    {
      "source": "/faq",
      "destination": "/faq/index.html"
    },
    {
      "source": "/houndsly",
      "destination": "/houndsly/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms/index.html"
    },
    {
      "source": "/matted-coat-policy",
      "destination": "/matted-coat-policy/index.html"
    },
    {
      "source": "/community",
      "destination": "/community/index.html"
    },
    {
      "source": "/nervous-anxious-dog-grooming",
      "destination": "/nervous-anxious-dog-grooming/index.html"
    },
    {
      "source": "/senior-blind-deaf-dog-grooming",
      "destination": "/senior-blind-deaf-dog-grooming/index.html"
    },
    {
      "source": "/doodle-grooming-matted-coats",
      "destination": "/doodle-grooming-matted-coats/index.html"
    },
    {
      "source": "/dog-de-shedding-ashton-under-lyne",
      "destination": "/dog-de-shedding-ashton-under-lyne/index.html"
    },
    {
      "source": "/sensitive-skin-dog-grooming-natural-shampoo",
      "destination": "/sensitive-skin-dog-grooming-natural-shampoo/index.html"
    },
    {
      "source": "/independent-dog-groomer-vs-chain",
      "destination": "/independent-dog-groomer-vs-chain/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/(book|staff|stafflogin|reset-password|app)(/.*)?",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://api.pwnedpasswords.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io https://*.ingest.de.sentry.io https://eu.i.posthog.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(app/assets|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/app/(fonts|icons|images)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sw\\.js|registerSW\\.js|push-sw\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(workbox-.*\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "smarterdog.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
